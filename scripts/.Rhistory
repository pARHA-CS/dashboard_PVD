newbase1524_2 <- newbase1524_2[, cols_existantes]
return(newbase1524_2)
}
genre_bdd_no_candid <- function(genre, data) {
genre <- as.integer(genre)
if (!is.integer(genre) || any(is.na(genre))) {
stop("genre doit être de type 'integer' valide")
}
data <- data |> filter(q1 == genre)
return(data)
}
genre_bdd <- function(genre, data, candidature) {
genre <- as.integer(genre)
if (!is.integer(genre) || any(is.na(genre))) {
stop("genre doit être de type 'integer' valide")
}
data <- data |> filter(q1 == genre,
ep15t %in% candidature)
return(data)
}
neet_var <- function(base) {
df <- tibble(Mois = 15:62) %>%
rowwise() %>%
mutate(NEET = (sum(base[[paste0("mois", Mois)]] == 2) / nrow(base)) * 100) %>%
ungroup()
return(df)
}
plot_acf_pacf <- function(series, title_suffix) {
acf(series, main = paste("ACF -", title_suffix), xlab = "Lag (mois)", xaxt = "n")
axis(1, at = seq(0, length.out = 17, by = 1/12), labels = seq(0, 16, by = 1))
pacf(series, main = paste("PACF -", title_suffix), xlab = "Lag (mois)", xaxt = "n")
axis(1, at = seq(0, length.out = 17, by = 1/12), labels = seq(0, 16, by = 1))
}
analyse_serie_temporelle <- function(ts) {
# Visualisation de la série
plot(ts, main = "Évolution du taux de NEET sur la période 15-62",
ylab = "Taux de NEET (%)",
xlab = "Mois",
xaxt = "n")
axis(1, at = time(ts), labels = seq(15, 62, by = 1), las = 2)
# Décomposition
decomposed <- decompose(ts)
plot(decomposed,
xlab = "Temps")
# Test ADF sur la série originale
adf_test <- adf.test(ts)
print(adf_test)
diff_series <- NULL
diff_series_2 <- NULL
if (adf_test$p.value > 0.05) {
# Différenciation 1
diff_series <- diff(ts)
plot(diff_series, main = "Série Différenciée (d=1)", ylab = "Taux de NEET (%)", xlab = "Temps", xaxt = "n")
axis(1, at = time(ts), labels = seq(15, 62, by = 1), las = 2)
adf_test_diff <- adf.test(diff_series)
print(adf_test_diff)
if (adf_test_diff$p.value > 0.05) {
# Différenciation 2
diff_series_2 <- diff(diff_series)
plot(diff_series, main = "Série Différenciée (d=2)", ylab = "Taux de NEET (%)", xlab = "Temps", xaxt = "n")
axis(1, at = time(ts), labels = seq(15, 62, by = 1), las = 2)
adf_test_diff_2 <- adf.test(diff_series_2)
print(adf_test_diff_2)
}
}
plot_acf_pacf(ts, "Série Originale")
if (!is.null(diff_series)) {
plot_acf_pacf(diff_series, "Série Différenciée 1")
}
if (!is.null(diff_series_2)) {
plot_acf_pacf(diff_series_2, "Série Différenciée 2")
}
}
plot_arima_fit <- function(ts_data, arima_model) {
fitted_values <- fitted(arima_model)
df_plot <- data.frame(
Time = as.numeric(time(ts_structures_publiques)),
Observed = as.numeric(ts_data),
Fitted = as.numeric(fitted_values)
)
ggplot(df_plot, aes(x = Time)) +
geom_line(aes(y = Observed, color = "Série originale")) +
geom_line(aes(y = Fitted, color = "Ajustement ARIMA")) +
ggtitle("Ajustement ARIMA sur la série temporelle") +
xlab("Temps") +
ylab("Valeurs") +
scale_color_manual(name = "Légende",
values = c("Série originale" = "black", "Ajustement ARIMA" = "red")) +
theme_minimal()
}
compare_time_series <- function(..., labels = NULL) {
ts_list <- list(...)
input_names <- sub("^ts_", "", as.character(match.call(expand.dots = TRUE))[-1])
if (!all(sapply(ts_list, is.ts))) {
stop("Toutes les entrées doivent être des objets de type 'ts'")
}
couleurs <- rainbow(length(ts_list))
y_min <- min(sapply(ts_list, min, na.rm = TRUE))
y_max <- max(sapply(ts_list, max, na.rm = TRUE))
plot(ts_list[[1]], col = couleurs[1], lwd = 2, ylim = c(y_min, y_max),
main = "Comparaison des séries temporelles NEET",
ylab = "Taux de NEET (%)", xlab = "Mois", xaxt = "n")
axis(1, at = time(ts_list[[1]]), labels = seq(15, 62, by = 1), las = 2)
if (length(ts_list) > 1) {
for (i in 2:length(ts_list)) {
lines(ts_list[[i]], col = couleurs[i], lwd = 2)
}
}
if (is.null(labels)) {
labels <- input_names
}
legend("topright", legend = labels, col = couleurs, lwd = 2, cex = 0.8)
}
test_normalite_residus <- function(model){
print(shapiro.test(model$residuals))
print(Box.test(model$residuals, lag = 10, type = "Ljung-Box"))
}
table_resultat_model <- function(model){
coefs <- model$coef
se <- sqrt(diag(model$var.coef))
# Calcul des p-values avec test de Wald
z_values <- coefs / se
p_values <- 2 * (1 - pnorm(abs(z_values)))  # Bilatéral
# Création d'un tableau des résultats
coef_table <- data.frame(
Coefficient = coefs,
`Std.Error` = se,
`Z-value` = z_values,
`P-value` = round(p_values,6)
)
return(kable(coef_table,
caption = "Tableau des Coefficients du Modèle ARIMA",
format = "latex",
booktabs = TRUE,
escape = FALSE) %>%
kable_styling(latex_options = c("HOLD_position")))
}
